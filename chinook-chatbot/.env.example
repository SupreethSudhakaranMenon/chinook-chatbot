# --- Option A: Ollama app, already signed in (cloud Gemma 4 31B) ---
# Local server proxies the cloud model. API key is required by the client but ignored.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=gemma4:31b-cloud

# --- Option B: Ollama Cloud API (no local server) ---
# OLLAMA_API_KEY=your_ollama_cloud_key
# OPENAI_BASE_URL=https://ollama.com/v1
# OPENAI_MODEL=gemma4:31b

# --- Option C: OpenAI ---
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Gemma 4 on Ollama Cloud does not support JSON response_format; leave this unset.
# LLM_JSON_MODE=false
